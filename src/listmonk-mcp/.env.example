# Example environment variables for Listmonk MCP Server

# Required: Full URL to your Listmonk API endpoint
LISTMONK_API_ENDPOINT="https://your-listmonk-instance.com/api"

# Required: API Username created in Listmonk (Admin -> Settings -> API Keys)
LISTMONK_API_USER="your_api_username"

# Required: API Password (or Token) for the API user
LISTMONK_API_TOKEN="your_api_password_or_token"

# Other variables from the original .env (if needed by other parts of a larger system)
# HOST_NAME=mail.example.com
# ADMIN_USER=admin
# ADMIN_PASSWORD=your_admin_password
# SESSION_KEY=your_listmonk_session_key

